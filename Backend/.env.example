# Copia este archivo como .env y ajusta los valores a tu entorno local.
# El archivo .env real NO se versiona (ver .gitignore).

# Servidor Express
PORT=3000
PUBLIC_PATH="public"

# PostgreSQL
# Los valores por defecto coinciden con docker-compose.yml (puerto 5433 en el host).
DB_HOST=localhost
DB_PORT=5433
DB_USER=user
DB_PASSWORD=123456
DB_NAME=proyecto-integrador-db
